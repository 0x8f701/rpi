{
  "name": "rpi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "rpi web client — vite + react + typescript, built into the rpi binary via build.rs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "coverage:build": "vite build --config vite.coverage.config.ts",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage": "bash ../../../E2E.d/web/coverage.sh"
  },
  "dependencies": {
    "katex": "^0.18.2",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "typescript": "^5.7.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
