/target
dist
# The web client's production build (vite-plugin-singlefile) emits exactly one
# self-contained file, crates/pi-cli/web/dist/index.html, which is COMMITTED so
# `cargo build` never requires node (see crates/pi-cli/build.rs). Re-include
# only that single artifact; everything else named `dist` stays ignored.
!crates/pi-cli/web/dist/
crates/pi-cli/web/dist/*
!crates/pi-cli/web/dist/index.html
node_modules
crates/pi-cli/web/.web-test-build/
crates/pi-cli/web/.transcript-test-build/
crates/pi-cli/web/.panel-shots/
/examples/target
*.log
/.pi/artifacts/
/diagram-output/
session.html
/.pi-subagents/
# Secrets and local credentials — never commit.
.env
.env.*
!.env.example
*.pem
*.key
auth.json
credentials*
# Test residue: integration tests run with the crate root as cwd and a
# relative session-dir, writing native sessions here.
/crates/pi-cli/sessions/
__pycache__
book
.web-test-build/
