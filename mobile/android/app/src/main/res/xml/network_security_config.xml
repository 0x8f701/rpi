<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Runner listeners serve self-signed certs (rcgen). Trust user-installed
         CAs so the operator can pin the runner cert on the device. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
